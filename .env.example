# Copy this file to .env and fill in. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cheap fast tier: where compression matters most for cost. Change if names differ.
OPENAI_MODEL=gpt-5.4-mini
CLAUDE_MODEL=claude-haiku-4-5

# Optional: USD per 1M tokens, from each provider's pricing page, for cost-per-correct-answer
OPENAI_PRICE_IN=
OPENAI_PRICE_OUT=
CLAUDE_PRICE_IN=
CLAUDE_PRICE_OUT=
